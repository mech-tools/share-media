<media-sidebar>
    {{!--  Sidebar Header  --}}
    {{#if user.isGM}}
        <header class="directory-header flexcol">
            <div class="header-actions action-buttons flexrow">

                {{!--  Share Media Link Button  --}}
                <button type="button" data-action="shareLink">
                    <i class="fa {{icons.shareLink}}"></i>
                    <span>{{localize "share-media.ui.sidebar.header.link.label"}}</span>
                </button>


                {{!--  Clear History Button  --}}
                <button type="button" data-action="clearHistory">
                    <i class="fa {{icons.clear}}"></i>
                    <span>{{localize "share-media.ui.sidebar.header.clear.label"}}</span>
                </button>
            </div>
        </header>
    {{/if}}

    {{!--  Sidebar Media List  --}}
    <div class="flexcol flex1 media-container">
        {{!--  Media Log  --}}
        <ol class="plain directory-list media-log"></ol>

        {{!--  Loading  --}}
        <span class="flexrow shm loading" hidden>
            <i class="fa {{icons.loading}}"></i> {{localize "share-media.ui.sidebar.loading"}}
        </span>

        {{!--  Jump to Bottom  --}}
        <button type="button" class="jump-to-bottom ui-control icon fa {{icons.jumpToBottom}}"
            data-action="jumpToBottom"
            data-tooltip="CHAT.JumpToBottom" data-tooltip-direction="UP" hidden></button>
    </div>
</media-sidebar>
