<section class="header flexrow">
    {{!--  Sidebar toggle  --}}
    <button type="button" class="inline-control collapse-toggle icon fa {{@root.icons.collapseOn}}"
        data-action="toggleSidebar"
        data-tooltip="Collapse"
        data-tooltip-direction="UP">
    </button>

    {{!--  Previous folder button  --}}
    <button type="button"
        class="backTraverse inline-control icon fa {{icons.folderBack}}"
        data-action="backTraverse"
        data-tooltip="FILES.TraverseBack"
        data-tooltip-direction="UP"
        {{disabled (not canGoBack)}}>
    </button>

    {{!--  Create directory button  --}}
    <button type="button"
        class="createDirectory inline-control icon fa {{icons.folderCreate}}"
        data-action="createDirectory"
        data-tooltip="FILES.CreateDirectory"
        data-tooltip-direction="UP"
        {{disabled (not canCreateFolder)}}>
    </button>

    {{!--  Upload button  --}}
    <button type="button"
        class="uploadFiles inline-control icon fa {{icons.folderUpload}}"
        data-tooltip="{{~ifThen canUpload "share-media.ui.browser.upload.label" "FILES.CannotUpload"}}"
        data-tooltip-direction="UP"
        {{disabled (not canUpload)}}>
    </button>

    {{!--  Favorites  --}}
    <div class="favorites-wrapper flex0">
        <button type="button"
            class="favorites inline-control icon fa {{icons.favorites}}"
            data-action="toggleFavorites"
            data-tooltip="FILES.FavoritesLabel"
            data-tooltip-direction="UP">
        </button>

        <div class="favorites-list flexrow">
            {{~#each favorites}}
                <div class="tag flexrow">
                    <a class="link" data-action="goToFavorite" data-path="{{this.path}}">{{this.label}}</a>
                    <button type="button" class="plain icon inline-control fa {{@root.icons.clear}}"
                        data-action="removeFavorite"
                        data-tooltip="FILES.RemoveFavorite"
                        data-path="{{this.path}}">
                    </button>
                </div>
            {{~/each}}

            <button type="button" class="plain icon inline-control fa {{icons.addFavorites}}"
                data-action="setFavorite"
                data-tooltip="FILES.AddFavorite">
            </button>
        </div>
    </div>

    {{!--  Search field  --}}
    <input type="search" name="filter" placeholder="{{localize "FILES.Search"}}">

    {{!--  File name toggle  --}}
    <button type="button"
        type="button"
        class="inline-control toggle-names icon fa-light {{@root.icons.title}} {{~#if displayNames}} active {{~/if}}"
        data-action="toggleNames"
        data-tooltip="share-media.ui.browser.fileNames.label"
        data-tooltip-direction="UP">
    </button>

    {{!--  Layout selector  --}}
    <div class="layout-wrapper">
        <i class="fa {{icons.layout}}"></i>
        <select name="layout" data-tooltip="share-media.ui.browser.layout.label" data-tooltip-direction="UP">
            {{selectOptions layouts selected=layout}}
        </select>
    </div>
</section>
